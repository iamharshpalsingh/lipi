# Types with fields and methods, and list operations on them.

type Rectangle
    width: number
    height: number

    area()
        return self.width * self.height

    describe()
        return "rectangle {self.width}x{self.height}"

type Circle
    radius: number

    area()
        return math.pi * self.radius ** 2

    describe()
        return "circle r={self.radius}"

shapes = [Rectangle(3, 4), Circle(radius: 1), Rectangle(width: 10, height: 2), Circle(2.5)]

for shape in shapes.sort_by(s => s.area())
    show "{shape.describe()}: area {shape.area().round(2)}"

total = shapes.map(s => s.area()).sum()
show "Total area: {total.round(2)}"

biggest = shapes.sort_by(s => s.area()).last
show "Biggest: {biggest.describe()}"
