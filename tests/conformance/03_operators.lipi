# SPEC §6: operators and precedence
show 2 + 3 * 4, (2 + 3) * 4, 2 ** 3 ** 2, -2 ** 2, 17 % 5, -17 % 5, 17.5 % 5, 9 / 2, 8 - 3
show 1 < 2, 2 <= 2, 3 > 4, 3 >= 3, 1 == 1.0, [1, [2]] == [1, [2]], {a: 1} != {a: 2}
show "b" > "a", "app" < "apple"
show 2 in [1, 2, 3], "x" not in "abc", "name" in {name: 1}
show true and false, true or false, not true, not (1 > 2)
missing = json.parse("null")
show missing ?? "default", 0 ?? 5, missing?.field
show "big" if 10 > 5 else "small"
show 1 to 5, 10 to 0 step -5, 0 to 10 step 3
show "ab" + "cd", [1] + [2, 3]
