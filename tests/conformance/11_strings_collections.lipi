# SPEC §4, §15: String, Array, Object and number methods
s = "  Hello, LiPi  "
show s.trim(), s.trim().upper(), s.trim().lower(), s.length
show "a,b,c".split(","), "one two".split(), "abc".chars(), "abc".reverse()
show "hello".contains("ell"), "hello".startsWith("he"), "hello".endsWith("lo"), "hello".indexOf("l")
show "hello".replace("l", "L"), "abcdef".slice(1, 3), "abc".slice(-2), "ab".repeat(3)
show "7".padStart(3, "0"), "x".padEnd(3, "."), "line1\nline2".lines(), "".isEmpty()
show "42".toNumber(), "4.5".toNumber(), "abc".toNumber()

items = [5, 3, 8, 1]
show items.sort(), items.reverse(), items.first, items.last, items.length
show items.map(x => x * 2), items.filter(x => x > 3), items.reduce((a, b) => a + b), items.reduce((a, b) => a + b, 100)
show items.find(x => x > 4), items.any(x => x > 7), items.all(x => x > 0), items.count(x => x > 2)
show items.sum(), items.min(), items.max(), items.indexOf(8), items.contains(3)
show [3, 1, 3].unique(), [[1, 2], [3]].flat(), items.slice(1, 3), items.join("-")
show [{n: "b"}, {n: "a"}].sortBy(x => x.n)

list = [1, 2]
list.push(3)
list.insert(0, 0)
show list, list.pop(), list.removeAt(0), list.remove(2), list

obj = {b: 2, a: 1}
show obj.keys(), obj.values(), obj.entries(), obj.has("a"), obj.get("z", "none"), obj.length
copy = obj.copy()
copy.c = 3
show obj.remove("b"), obj, copy

pi = 3.14159
half = 2.5
negative = -3.7
seven = 7
show pi.round(2), half.round(), negative.floor(), pi.ceil(), (-4).abs(), seven.toString()
