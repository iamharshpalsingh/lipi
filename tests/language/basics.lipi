# Variables, numbers, strings, booleans and show
name = "Dezy"
age = 25
show "Hello World"
show name, age
show "Name: {name}, next year: {age + 1}"

if age >= 18
    show "Adult"
else
    show "Minor"

show 7 / 2, 7 % 3, -7 % 3, 2 ** 10
show 0.1 + 0.2
show 10 / 4 * 2
show "abc" + "def"
show true and false, true or false, not true
show nil ?? "fallback"
show 3 == 3.0, [1, 2] == [1, 2], {a: 1} == {a: 1}
show "x" in ["x", "y"], "ell" in "hello", 5 not in [1, 2]

const PI = 3.14159
radius: number = 2
show "Area: {(PI * radius ** 2).round(2)}"

price = 100
price += 50
price -= 20
price *= 2
show price

multi = """
Line one
Line two with {name}
"""
show multi.trim()
show "tab\there", "quote \"x\"", "brace \{not code\}"
