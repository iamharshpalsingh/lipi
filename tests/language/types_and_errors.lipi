# Types (structs with methods), try/catch/finally, throw
type Point
    x: Integer
    y: Integer = 0

    distanceTo(other)
        dx = other.x - self.x
        dy = other.y - self.y
        return math.sqrt(dx * dx + dy * dy)

    moved(dx, dy)
        return Point(self.x + dx, self.y + dy)

a = Point(0, 0)
b = Point(x: 3, y: 4)
show a, b
show a.distanceTo(b)
show b.moved(1, 1).x
show typeOf(a), typeOf(1), typeOf("s"), typeOf([]), typeOf({}), typeOf(null), typeOf(showError)

showError(err)
    show "caught:", err.message

try
    a.z = 1
catch err
    showError(err)

# (Calling Point(y: 2) directly is caught before the program even runs;
# going through a variable defers the check to runtime.)
makePoint = Point
try
    makePoint(y: 2)
catch err
    showError(err)

try
    throw "something broke"
catch err
    showError(err)
    show err.code, err.category

try
    throw {message: "custom", code: 42}
catch err
    show "custom error code:", err.code

try
    items = [1, 2, 3]
    show items[10]
catch err
    showError(err)
    show err.code
finally
    show "finally runs"

safeDivide(a, b)
    if b == 0
        throw "can't divide {a} by zero"
    return a / b

try
    safeDivide(1, 0)
catch problem
    showError(problem)

try
    json.parse('{bad json}')
catch err
    show "json error caught"

typed(x: Integer) -> String
    return "number {x}"

label = toString(5)
try
    typed(label)
catch err
    showError(err)
