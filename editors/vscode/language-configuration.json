{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "folding": { "offSide": true },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((if|else|for|while|repeat|try|catch|finally|match|type|test)\\b.*|(async\\s+)?(function\\s+)?[A-Za-z_][A-Za-z0-9_]*\\([^()]*\\)\\s*(->\\s*[A-Za-z_\\[\\]?]+)?\\s*|.*\\bwith\\s+[A-Za-z_][A-Za-z0-9_, ]*)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(else|catch|finally)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(return|break|continue|throw)\\b.*$",
      "action": { "indent": "outdent" }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
