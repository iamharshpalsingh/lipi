{
  "name": "lipi",
  "displayName": "LiPi",
  "description": "LiPi language support: errors as you type, completion, hover docs, go to definition, formatting, syntax highlighting and file icons.",
  "version": "1.1.2",
  "publisher": "lipi-lang",
  "author": { "name": "Harsh Pal Singh", "url": "https://github.com/iamharshpalsingh" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/iamharshpalsingh/lipi" },
  "homepage": "https://github.com/iamharshpalsingh/lipi",
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#F6F1EA", "theme": "light" },
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "keywords": ["lipi", "language"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:lipi"],
  "contributes": {
    "languages": [
      {
        "id": "lipi",
        "aliases": ["LiPi", "lipi"],
        "extensions": [".lipi"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/lipi-file-light.svg",
          "dark": "./images/lipi-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "lipi",
        "scopeName": "source.lipi",
        "path": "./syntaxes/lipi.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "LiPi",
      "properties": {
        "lipi.path": {
          "type": "string",
          "default": "lipi",
          "description": "The lipi program used for the language server (a full path if it isn't on your PATH)."
        }
      }
    },
    "configurationDefaults": {
      "[lipi]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
